# Tuiton — Phase 1 environment variables

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://tuiton:tuiton_dev@localhost:5432/tuiton?schema=public"

# Redis (cache, queues, sessions)
REDIS_URL="redis://localhost:6379"

# Auth (Phase 1: email OTP + Google)
# Email OTP provider (MSG91 / Twilio) — configure in Phase 1 hardening
OTP_PROVIDER=console
OTP_FROM=Tuiton

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jitsi (live classes) — self-hosted
JITSI_DOMAIN=meet.tuiton.local
JITSI_APP_ID=
JITSI_APP_SECRET=

# Storage (S3-compatible) — recordings, uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notifications
RESEND_API_KEY=
FCM_SERVER_KEY=

# Payments (Phase 6 only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
